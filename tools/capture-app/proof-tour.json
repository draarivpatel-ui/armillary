{
  "version": 1,
  "name": "SNAP proof: every view in both themes, a 3 second burst on the Orrery, a WebGL probe",
  "window": { "width": 1440, "height": 900 },
  "theme": "dark",
  "steps": [
    { "op": "waitFrames", "frames": 30 },
    { "op": "navigate", "view": "orrery" },
    { "op": "snapshot", "name": "dark-1-orrery" },
    { "op": "navigate", "view": "almanac" },
    { "op": "snapshot", "name": "dark-2-almanac" },
    { "op": "navigate", "view": "folio" },
    { "op": "snapshot", "name": "dark-3-folio" },
    { "op": "navigate", "view": "field-guide" },
    { "op": "snapshot", "name": "dark-4-field-guide" },
    { "op": "navigate", "view": "switchboard" },
    { "op": "snapshot", "name": "dark-5-switchboard" },
    { "op": "navigate", "view": "launchpad" },
    { "op": "waitFrames", "frames": 20 },
    { "op": "snapshot", "name": "dark-6-launchpad" },
    { "op": "navigate", "view": "search" },
    { "op": "snapshot", "name": "dark-7-search" },
    { "op": "theme", "theme": "light" },
    { "op": "navigate", "view": "orrery" },
    { "op": "snapshot", "name": "light-1-orrery" },
    { "op": "navigate", "view": "almanac" },
    { "op": "snapshot", "name": "light-2-almanac" },
    { "op": "navigate", "view": "folio" },
    { "op": "snapshot", "name": "light-3-folio" },
    { "op": "navigate", "view": "field-guide" },
    { "op": "snapshot", "name": "light-4-field-guide" },
    { "op": "navigate", "view": "switchboard" },
    { "op": "snapshot", "name": "light-5-switchboard" },
    { "op": "navigate", "view": "launchpad" },
    { "op": "snapshot", "name": "light-6-launchpad" },
    { "op": "navigate", "view": "search" },
    { "op": "snapshot", "name": "light-7-search" },
    { "op": "theme", "theme": "dark" },
    { "op": "navigate", "view": "orrery" },
    { "op": "burst", "name": "orrery-burst", "durationMs": 3000 },
    { "op": "hook", "name": "__armillaryCapture.webglProbe" },
    { "op": "waitFrames", "frames": 10 },
    { "op": "snapshot", "name": "webgl-probe" },
    { "op": "hook", "name": "__armillaryCapture.removeProbe" },
    { "op": "quit" }
  ]
}
