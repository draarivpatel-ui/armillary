{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Event listen and unlisten (Tauri cannot scope these per event name; the app listens to import:progress, live:update, pty:data and the firstrun:* events) plus an explicit allow for each application command. No window, path, menu, tray, webview, image or resource permissions, and no plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-agents-list",
    "allow-config-list",
    "allow-live-list",
    "allow-pty-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-close",
    "allow-import-now",
    "allow-sessions-query",
    "allow-session-get",
    "allow-messages-page",
    "allow-import-diagnostics",
    "allow-search",
    "allow-services-start",
    "allow-archive-delete",
    "allow-archive-status",
    "allow-archive-move-aside",
    "allow-ui-trace",
    "allow-display-context",
    "allow-firstrun-status",
    "allow-firstrun-plan",
    "allow-firstrun-consent",
    "allow-firstrun-scan",
    "allow-firstrun-complete",
    "allow-firstrun-reset",
    "allow-firstrun-fps-enabled",
    "allow-firstrun-fps-report"
  ]
}
